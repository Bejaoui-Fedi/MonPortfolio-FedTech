class HomeView extends StatefulWidget {
  const HomeView({super.key});

  @override
  State<HomeView> createState() => _HomeViewState();
}

class _HomeViewState extends State<HomeView> {
  final GlobalKey _expertisesKey = GlobalKey();
  final GlobalKey _competencesKey = GlobalKey();
  final GlobalKey _realisationsKey = GlobalKey();
  final GlobalKey _carriereKey = GlobalKey();
  final GlobalKey _formationKey = GlobalKey();
  final GlobalKey _iotKey = GlobalKey();
  final GlobalKey _contactKey = GlobalKey();

  void _scrollToSection(GlobalKey key) {
    if (key.currentContext != null) {
      Scrollable.ensureVisible(
        key.currentContext!,
        duration: const Duration(milliseconds: 600),
        curve: Curves.easeInOut,
      );
    }
  }

  PopupMenuItem<GlobalKey> _buildPopupMenuItem(String title, IconData icon, GlobalKey key) {
    return PopupMenuItem<GlobalKey>(
      value: key,
      child: Row(
        children: [
          Icon(
            icon,
            color: const Color(0xFF00E5FF),
            size: 20,
          ),
          const SizedBox(width: 12),
          Text(
            title,
            style: GoogleFonts.orbitron(
              color: Colors.white,
              fontSize: 13,
              fontWeight: FontWeight.bold,
              letterSpacing: 1,
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final isDesktop = MediaQuery.of(context).size.width > 800;
    
    return Scaffold(
      extendBodyBehindAppBar: true,
      appBar: AppBar(
        title: Text('FEDTECH', style: GoogleFonts.orbitron(fontWeight: FontWeight.w900, letterSpacing: 4)),
        backgroundColor: Colors.transparent,
        elevation: 0,
        flexibleSpace: ClipRect(
          child: BackdropFilter(
            filter: ui.ImageFilter.blur(sigmaX: 10, sigmaY: 10),
            child: Container(color: Colors.white.withAlpha(12)),
          ),
        ),
        actions: [
          if (isDesktop) ...[
            _HoverNavButton(title: 'Expertises', onTap: () => _scrollToSection(_expertisesKey)),
            const SizedBox(width: 8),
            _HoverNavButton(title: 'Compétences', onTap: () => _scrollToSection(_competencesKey)),
            const SizedBox(width: 8),
            _HoverNavButton(title: 'Réalisations', onTap: () => _scrollToSection(_realisationsKey)),
            const SizedBox(width: 8),
            _HoverNavButton(title: 'Carrière', onTap: () => _scrollToSection(_carriereKey)),
            const SizedBox(width: 8),
            _HoverNavButton(title: 'Formation', onTap: () => _scrollToSection(_formationKey)),
            const SizedBox(width: 8),
            _HoverNavButton(title: 'IoT & Conceptions', onTap: () => _scrollToSection(_iotKey)),
            const SizedBox(width: 8),
            _HoverNavButton(title: 'Contact', onTap: () => _scrollToSection(_contactKey)),
            const SizedBox(width: 24),
          ] else
            PopupMenuButton<GlobalKey>(
              icon: const Icon(Icons.menu, color: Colors.white),
              color: const Color(0xFF0A0E21).withAlpha(242),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(16),
                side: BorderSide(
                  color: const Color(0xFF00E5FF).withAlpha(76),
                  width: 1.5,
                ),
              ),
              onSelected: _scrollToSection,
              itemBuilder: (context) => [
                _buildPopupMenuItem('Expertises', Icons.bolt_outlined, _expertisesKey),
                _buildPopupMenuItem('Compétences', Icons.code_outlined, _competencesKey),
                _buildPopupMenuItem('Réalisations', Icons.rocket_launch_outlined, _realisationsKey),
                _buildPopupMenuItem('Carrière', Icons.work_history_outlined, _carriereKey),
                _buildPopupMenuItem('Formation', Icons.school_outlined, _formationKey),
                _buildPopupMenuItem('IoT & Conceptions', Icons.developer_board_outlined, _iotKey),
                _buildPopupMenuItem('Contact', Icons.contact_mail_outlined, _contactKey),
              ],
            ),
          Padding(
            padding: const EdgeInsets.only(right: 16.0),
            child: Tooltip(
              message: 'SYSTEM',
              child: GestureDetector(
                onLongPress: () => context.go('/admin'),
                child: IconButton(
                  icon: const Icon(Icons.terminal_outlined, color: Colors.white24, size: 20),
                  onPressed: () {
                    // Quick press does nothing or shows a subtle hint
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text('Access Restricted: Authorization Required', style: TextStyle(color: Color(0xFF00E5FF), fontSize: 10)),
                        backgroundColor: Colors.transparent,
                        duration: Duration(seconds: 1),
                      ),
                    );
                  },
                ),
              ),
            ),
          ),
        ],
      ),
      body: Stack(
        children: [
          const BackgroundDecorations(),
          SingleChildScrollView(
            padding: const EdgeInsets.fromLTRB(24, 120, 24, 24),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const HeroSection().animate().fadeIn(duration: 800.ms).slideY(begin: 0.2, end: 0, curve: Curves.easeOutBack),
                const SizedBox(height: 80),

                Container(key: _expertisesKey, child: const SectionHeader(title: 'Expertises')).animate().fadeIn(delay: 200.ms).slideX(),
                const SizedBox(height: 32),
                LayoutBuilder(
                  builder: (context, constraints) {
                    return Consumer<PortfolioService>(
                      builder: (context, portfolio, _) {
                        return GridView.builder(
                          shrinkWrap: true,
                          physics: const NeverScrollableScrollPhysics(),
                          gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                            crossAxisCount: constraints.maxWidth < 600 ? 1 : (constraints.maxWidth < 1000 ? 2 : 3),
                            crossAxisSpacing: 20,
                            mainAxisSpacing: 20,
                            childAspectRatio: constraints.maxWidth < 600 ? 1.6 : 1.2,
                          ),
                          itemCount: portfolio.services.length,
                          itemBuilder: (context, index) {
                            return ServiceCard(service: portfolio.services[index])
                                .animate()
                                .fadeIn(delay: (400 + (index * 100)).ms)
                                .scale(delay: (400 + (index * 100)).ms);
                          },
                        );
                      },
                    );
                  },
                ),
                const SizedBox(height: 80),
                Container(key: _competencesKey, child: const SectionHeader(title: 'Compétences')).animate().fadeIn(delay: 500.ms).slideX(),
                const SizedBox(height: 32),
                Consumer<PortfolioService>(
                  builder: (context, portfolio, _) {
                    return Wrap(
                      spacing: 12,
                      runSpacing: 12,
                      children: portfolio.skills.asMap().entries.map((entry) {
                        final index = entry.key;
                        final skill = entry.value;
                        return SkillTag(skill: skill)
                            .animate()
                            .fadeIn(delay: (500 + (index * 50)).ms)
                            .scale(delay: (500 + (index * 50)).ms);
                      }).toList(),
                    );
                  },
                ),
                const SizedBox(height: 80),

                Container(key: _realisationsKey, child: const SectionHeader(title: 'Réalisations')).animate().fadeIn(delay: 600.ms).slideX(),
                const SizedBox(height: 32),
                ProjectsSection(),
                const SizedBox(height: 80),

                Container(key: _carriereKey, child: const SectionHeader(title: 'Carrière')).animate().fadeIn(delay: 1000.ms).slideX(),
                const SizedBox(height: 32),
                Consumer<PortfolioService>(
                  builder: (context, portfolio, _) {
                    return ListView.builder(
                      shrinkWrap: true,
                      physics: const NeverScrollableScrollPhysics(),
                      itemCount: portfolio.experiences.length,
                      itemBuilder: (context, index) {
                        return ExperienceTile(experience: portfolio.experiences[index])
                            .animate()
                            .fadeIn(delay: (1200 + (index * 200)).ms)
                            .slideX(begin: -0.05, end: 0);
                      },
                    );
                  },
                ),
                const SizedBox(height: 80),

                Container(key: _formationKey, child: const SectionHeader(title: 'Formation')).animate().fadeIn(delay: 1400.ms).slideX(),
                const SizedBox(height: 32),
                Consumer<PortfolioService>(
                  builder: (context, portfolio, _) {
                    return ListView.builder(
                      shrinkWrap: true,
                      physics: const NeverScrollableScrollPhysics(),
                      itemCount: portfolio.education.length,
                      itemBuilder: (context, index) {
                        return EducationTile(education: portfolio.education[index])
                            .animate()
                            .fadeIn(delay: (1600 + (index * 200)).ms)
                            .slideX(begin: 0.05, end: 0);
                      },
                    );
                  },
                ),
                const SizedBox(height: 80),

                Container(key: _iotKey, child: const SectionHeader(title: 'IoT & Conceptions')).animate().fadeIn(delay: 1600.ms).slideX(),
                const SizedBox(height: 32),
                const IoTDesignsSection(),
                const SizedBox(height: 80),

                Container(key: _contactKey, child: const SectionHeader(title: 'Coordonnées')).animate().fadeIn(delay: 1800.ms).slideX(),
                const SizedBox(height: 32),
                const ContactSection(),
                const SizedBox(height: 100),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

class BackgroundDecorations extends StatelessWidget {
  const BackgroundDecorations({super.key});

  @override
  Widget build(BuildContext context) {
    return Stack(
      children: [
        Positioned(
          top: -100,
          right: -100,
          child: Container(
            width: 300,
            height: 300,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: const Color(0xFF00E5FF).withAlpha(12),
            ),
          ),
        ).animate(onPlay: (controller) => controller.repeat(reverse: true))
          .moveY(begin: 0, end: 50, duration: 4.seconds),
        Positioned(
          bottom: 100,
          left: -50,
          child: Container(
            width: 200,
            height: 200,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: const Color(0xFFBD00FF).withAlpha(12),
            ),
          ),
        ).animate(onPlay: (controller) => controller.repeat(reverse: true))
          .moveX(begin: 0, end: 30, duration: 5.seconds),
      ],
    );
  }
}

class HeroSection extends StatelessWidget {
  const HeroSection({super.key});

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        return Consumer<PortfolioService>(
          builder: (context, portfolio, _) {
            final isMobile = constraints.maxWidth < 600;
            return Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Container(width: 40, height: 2, color: const Color(0xFF00E5FF)),
                          const SizedBox(width: 8),
                          const HeroWelcomeText(),
                        ],
                      ),
                      const SizedBox(height: 24),
                      Row(
                        crossAxisAlignment: CrossAxisAlignment.center,
                        children: [
                          Expanded(
                            child: Text(
                              portfolio.name,
                              style: Theme.of(context).textTheme.displayLarge?.copyWith(
                                fontSize: isMobile ? 42 : 64,
                                height: 1,
                              ),
                            ),
                          ),
                          if (isMobile) const SizedBox(width: 16),
                          if (isMobile) ProfilePicture(size: 80, imageUrl: portfolio.profileImageUrl).animate(onPlay: (c) => c.repeat(reverse: true)).moveY(begin: -5, end: 5, duration: 2.seconds, curve: Curves.easeInOut),
                        ],
                      ),
                      const SizedBox(height: 12),
                      ShaderMask(
                        shaderCallback: (bounds) => const LinearGradient(
                          colors: [Color(0xFF00E5FF), Color(0xFFBD00FF)],
                        ).createShader(bounds),
                        child: Text(
                          portfolio.headline,
                          style: Theme.of(context).textTheme.headlineMedium?.copyWith(
                            fontWeight: FontWeight.bold,
                            color: Colors.white,
                            fontSize: isMobile ? 20 : 28,
                          ),
                        ),
                      ).animate().fadeIn(delay: 400.ms).slideX(begin: 0.1, end: 0),
                      const SizedBox(height: 32),
                      Text(
                        portfolio.bio,
                        style: TextStyle(fontSize: 16, color: Colors.white.withAlpha(153), height: 1.6),
                      ).animate().fadeIn(delay: 600.ms),
                    ],
                  ),
                ),
                if (!isMobile) const SizedBox(width: 60),
                if (!isMobile) ProfilePicture(size: 200, imageUrl: portfolio.profileImageUrl).animate(onPlay: (c) => c.repeat(reverse: true)).moveY(begin: -10, end: 10, duration: 3.seconds, curve: Curves.easeInOut),
              ],
            );
          },
        );
      },
    );
  }
}

